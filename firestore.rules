rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each table lives under tables/<key>, where <key> is a 64-character code made from the table password.
    // The list of tables can't be read, so joining a table needs its password.
    // Members sign in with a username and password. The table's creator is its GM, and GMs can make others GMs.
    // GMs see and edit everything; players see and edit only the characters assigned to them.
    function signedIn() { return request.auth != null; }
    function memberDoc(t) { return /databases/$(database)/documents/tables/$(t)/members/$(request.auth.uid); }
    function isMember(t) { return signedIn() && exists(memberDoc(t)); }
    function isGM(t) { return isMember(t) && get(memberDoc(t)).data.role == "gm"; }
    function ownerOf(t) { return get(/databases/$(database)/documents/tables/$(t)/meta/table).data.get("owner", ""); }
    function plays(list) { return signedIn() && request.auth.uid in list; }

    // Which table an account belongs to, so signing in on a new device needs no table password.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // The marker that says a table exists, and who created it.
    match /tables/{t}/meta/{doc} {
      allow get: if signedIn() && t.size() == 64;
      allow create: if signedIn() && t.size() == 64 && doc == "table" && request.resource.data.owner == request.auth.uid;
      // A table made before GM roles existed: the first person to claim it becomes its GM.
      allow update: if signedIn() && doc == "table" && resource.data.get("owner", "") == ""
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["owner"])
                    && request.resource.data.owner == request.auth.uid;
    }

    // Who is at the table. You join as a player (or as GM if you created the table); only a GM changes roles.
    match /tables/{t}/members/{uid} {
      allow read: if isMember(t) || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && t.size() == 64
                    && exists(/databases/$(database)/documents/tables/$(t)/meta/table)
                    && (request.resource.data.role == "player" || (request.resource.data.role == "gm" && ownerOf(t) == uid));
      allow update: if isGM(t) || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isGM(t);
    }

    // Characters (and companions). Players create their own; only a GM can change who a character belongs to,
    // or switch Free edit on or off for it.
    match /tables/{t}/characters/{id} {
      allow read: if isGM(t) || (isMember(t) && plays(resource.data.get("players", [])));
      allow create: if isGM(t) || (isMember(t) && request.resource.data.get("players", []) == [request.auth.uid]
                    && request.resource.data.get("freeEdit", false) == false);
      allow update: if isGM(t) || (isMember(t) && plays(resource.data.get("players", []))
                    && request.resource.data.get("players", []) == resource.data.get("players", [])
                    && request.resource.data.get("freeEdit", false) == resource.data.get("freeEdit", false));
      allow delete: if isGM(t) || (isMember(t) && plays(resource.data.get("players", [])));
    }

    // The initiative deck is the GM's.
    match /tables/{t}/encounters/{id} {
      allow read, write: if isGM(t);
    }

    // Portraits, shared by everyone at the table.
    match /tables/{t}/portraits/{id} {
      allow read, write: if isMember(t);
    }

    // Hidden mini-game (Skyward Boiler): one shared high-score list for every visitor.
    // Anyone may read it and add a score; nobody can edit or delete entries from the site.
    match /arcade/{game}/scores/{id} {
      allow read: if game == "skyward-boiler";
      allow create: if game == "skyward-boiler"
                    && request.resource.data.keys().hasOnly(["name", "score", "at"])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 16
                    && request.resource.data.score is int
                    && request.resource.data.score > 0 && request.resource.data.score <= 9999
                    && request.resource.data.at == request.time;
    }

    // Hidden game (Furnace Below): shared high scores with the floor reached. Read by anyone, add-only.
    match /arcade/furnace-below/scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["name", "score", "floor", "at"])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 16
                    && request.resource.data.score is int
                    && request.resource.data.score > 0 && request.resource.data.score <= 999999
                    && request.resource.data.floor is int
                    && request.resource.data.floor >= 1 && request.resource.data.floor <= 999
                    && request.resource.data.at == request.time;
    }
  }
}
